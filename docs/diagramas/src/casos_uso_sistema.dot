digraph G {
graph [bgcolor="white",pad="0.33",nodesep="0.34",ranksep="1.0",splines=polyline,fontname="Arial"];
node [fontname="Arial",fontsize=11];
edge [fontname="Arial",fontsize=10,color="#475569",penwidth=1.2];
rankdir=LR;
node [shape=plaintext,style="",fontcolor="#23374D",fontsize=11];
cajero [label="«actor»\nCajero"];
quimico [label="«actor»\nQuímico\nfarmacéutico"];
alm [label="«actor»\nAlmacenero"];
admin [label="«actor»\nAdministrador"];
subgraph cluster_app { label="FARMACONTROL | SISTEMA (versión 2.1)";fontname="Arial";fontsize=16;fontcolor="#0B6956";color="#84CCB0";style=rounded;margin=20;
node [shape=ellipse,style=filled,fillcolor="#F2FBF7",color="#14946C",fontsize=10,fontcolor="#23374D"];
u1 [label="CU-01\nIngresar al sistema"];
