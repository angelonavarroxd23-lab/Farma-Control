}
cajero -> u2 [dir=none];cajero -> u3 [dir=none];cajero -> u4 [dir=none];cajero -> u5 [dir=none];cajero -> u6 [dir=none];cajero -> u9 [dir=none];
quimico -> u4 [dir=none];quimico -> u3 [dir=none];quimico -> u9 [dir=none];
alm -> u7 [dir=none];alm -> u8 [dir=none];alm -> u9 [dir=none];alm -> u13 [dir=none];
