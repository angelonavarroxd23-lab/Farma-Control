digraph G {
rankdir=LR; nodesep=0.35; ranksep=1.1; splines=true; bgcolor="white";
node [shape=plain, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, color="#444444", arrowhead=crow, arrowtail=tee, dir=both, arrowsize=0.8];
Rol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#E8F1FB"><B>Rol</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>rol_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">nombre : NVARCHAR(40) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">descripcion : NVARCHAR(180) NULL</TD></TR></TABLE>>];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#E8F1FB"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>usuario_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">rol_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">nombres : NVARCHAR(120) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">correo : NVARCHAR(160) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">hash_contrasena : NVARCHAR(255) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">activo : BIT </TD></TR></TABLE>>];
Cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#E6F6EE"><B>Cliente</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>cliente_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">tipo_documento : VARCHAR(3) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">numero_documento : VARCHAR(15) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">nombre_razon_social : NVARCHAR(160) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">telefono : VARCHAR(20) NULL</TD></TR></TABLE>>];
Proveedor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#E6F6EE"><B>Proveedor</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>proveedor_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">ruc : CHAR(11) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">razon_social : NVARCHAR(180) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">contacto : NVARCHAR(120) NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">telefono : VARCHAR(20) NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">activo : BIT </TD></TR></TABLE>>];
Categoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FFF4DC"><B>Categoria</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>categoria_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">nombre : NVARCHAR(90) </TD></TR></TABLE>>];
Medicamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FFF4DC"><B>Medicamento</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>medicamento_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">categoria_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">sku : VARCHAR(30) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">nombre : NVARCHAR(160) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">principio_activo : NVARCHAR(160) NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">presentacion : NVARCHAR(90) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">precio_venta : DECIMAL(12,2) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">requiere_receta : BIT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">activo : BIT </TD></TR></TABLE>>];
Receta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#E6F6EE"><B>Receta</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>receta_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">cliente_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">numero_receta : VARCHAR(50) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">nombre_prescriptor : NVARCHAR(160) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha_emision : DATE </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha_vencimiento : DATE </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">estado : VARCHAR(12) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">observacion : NVARCHAR(250) NULL</TD></TR></TABLE>>];
Lote [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FFF4DC"><B>Lote</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>lote_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">medicamento_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">codigo_lote : NVARCHAR(60) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha_vencimiento : DATE </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">stock_actual : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">stock_minimo : INT </TD></TR></TABLE>>];
Compra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FBE9E7"><B>Compra</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>compra_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">proveedor_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">usuario_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha : DATETIME </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">numero_documento : VARCHAR(40) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">total : DECIMAL(14,2) </TD></TR></TABLE>>];
DetalleCompra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FBE9E7"><B>DetalleCompra</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>detalle_compra_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">compra_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">lote_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">cantidad : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">costo_unitario : DECIMAL(12,2) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">subtotal : DECIMAL(14,2) calculada </TD></TR></TABLE>>];
Venta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FBE9E7"><B>Venta</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>venta_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">cliente_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">usuario_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">receta_id : INT NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha : DATETIME </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">tipo_comprobante : VARCHAR(10) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">numero_comprobante : VARCHAR(30) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">estado : VARCHAR(12) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">total : DECIMAL(14,2) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha_anulacion : DATETIME NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">usuario_anulacion_id : INT NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">motivo_anulacion : NVARCHAR(250) NULL</TD></TR></TABLE>>];
DetalleVenta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FBE9E7"><B>DetalleVenta</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>detalle_venta_id : INT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">venta_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">lote_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">cantidad : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">precio_unitario : DECIMAL(12,2) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">subtotal : DECIMAL(14,2) calculada </TD></TR></TABLE>>];
MovimientoStock [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#FFF4DC"><B>MovimientoStock</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>movimiento_id : BIGINT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">lote_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">usuario_id : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">compra_id : INT NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">venta_id : INT NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">tipo : VARCHAR(18) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">cantidad : INT </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha : DATETIME </TD></TR></TABLE>>];
AuditoriaOperacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#E8F1FB"><B>AuditoriaOperacion</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>auditoria_id : BIGINT </B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">usuario_id : INT NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">accion : VARCHAR(40) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">entidad : VARCHAR(40) </TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">entidad_id : INT NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">detalle : NVARCHAR(500) NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">ip : VARCHAR(45) NULL</TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"> </TD><TD ALIGN="LEFT">fecha : DATETIME </TD></TR></TABLE>>];
Rol -> Usuario [taillabel="1", headlabel="N", label="rol_id", labelfontsize=8];
Categoria -> Medicamento [taillabel="1", headlabel="N", label="categoria_id", labelfontsize=8];
Cliente -> Receta [taillabel="1", headlabel="N", label="cliente_id", labelfontsize=8];
Medicamento -> Lote [taillabel="1", headlabel="N", label="medicamento_id", labelfontsize=8];
Proveedor -> Compra [taillabel="1", headlabel="N", label="proveedor_id", labelfontsize=8];
Usuario -> Compra [taillabel="1", headlabel="N", label="usuario_id", labelfontsize=8];
Compra -> DetalleCompra [taillabel="1", headlabel="N", label="compra_id", labelfontsize=8];
Lote -> DetalleCompra [taillabel="1", headlabel="N", label="lote_id", labelfontsize=8];
Cliente -> Venta [taillabel="1", headlabel="N", label="cliente_id", labelfontsize=8];
Usuario -> Venta [taillabel="1", headlabel="N", label="usuario_id", labelfontsize=8];
Receta -> Venta [taillabel="1", headlabel="N", label="receta_id", labelfontsize=8];
Usuario -> Venta [taillabel="1", headlabel="N", label="usuario_anulacion_id", labelfontsize=8];
Venta -> DetalleVenta [taillabel="1", headlabel="N", label="venta_id", labelfontsize=8];
Lote -> DetalleVenta [taillabel="1", headlabel="N", label="lote_id", labelfontsize=8];
Lote -> MovimientoStock [taillabel="1", headlabel="N", label="lote_id", labelfontsize=8];
Usuario -> MovimientoStock [taillabel="1", headlabel="N", label="usuario_id", labelfontsize=8];
Compra -> MovimientoStock [taillabel="1", headlabel="N", label="compra_id", labelfontsize=8];
Venta -> MovimientoStock [taillabel="1", headlabel="N", label="venta_id", labelfontsize=8];
Usuario -> AuditoriaOperacion [taillabel="1", headlabel="N", label="usuario_id", labelfontsize=8];
}