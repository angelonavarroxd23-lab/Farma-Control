digraph G {
rankdir=LR; nodesep=0.35; ranksep=1.1; splines=true; bgcolor="white";
node [shape=plain, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, color="#444444", arrowhead=crow, arrowtail=tee, dir=both, arrowsize=0.8];
