ini->a->b->c->d; d->e [label="Sí"]; e->c; d->f [label="No"]; f->g; g->c [label="Sí"]; g->h [label="No"]; h->i [label="Sí"]; h->j [label="No"]; i->k [label="No"]; i->j [label="Sí"]; j->k [label="Sí"]; j->l [label="No"]; k->fin; l->m->fin;
