digraph A { bgcolor=white; nodesep=0.35; ranksep=0.35; node [fontname=Helvetica, fontsize=11, style=filled, fillcolor="#F4F9F7", shape=box, style="rounded,filled"]; edge [fontname=Helvetica, fontsize=9];
ini [shape=circle, label="", width=0.25, fillcolor=black, style=filled]; fin [shape=doublecircle, label="", width=0.25, fillcolor=black, style=filled];
a [label="Iniciar sesión (Cajero o Administrador)"]; b [label="Seleccionar cliente y tipo de comprobante"]; c [label="Buscar producto y elegir lote"];
d [shape=diamond, style=filled, fillcolor="#FFF4DC", label="¿Lote vencido o\nstock insuficiente?"]; e [label="Rechazar línea y\nmostrar motivo", fillcolor="#FBE9E7"]; f [label="Agregar línea al carrito"];
g [shape=diamond, style=filled, fillcolor="#FFF4DC", label="¿Más\nproductos?"]; h [shape=diamond, style=filled, fillcolor="#FFF4DC", label="¿Medicamento\ncon receta?"]; i [shape=diamond, style=filled, fillcolor="#FFF4DC", label="¿Receta válida, vigente\ny del cliente?"];
