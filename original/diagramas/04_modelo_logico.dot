digraph G {
graph [bgcolor="white",pad="0.4",rankdir=LR,nodesep="0.3",ranksep="1.2",splines=polyline,fontname="Arial",label="MODELO LÓGICO | CLAVES PRIMARIAS Y FORÁNEAS",labelloc=t,fontsize=19,fontcolor="#0B6956"];
