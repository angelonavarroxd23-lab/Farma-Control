digraph G {
graph [bgcolor="white",pad="0.35",rankdir=LR,nodesep="0.65",ranksep="1.0",splines=polyline,fontname="Arial",label="MODELO CONCEPTUAL | ENTIDADES Y RELACIONES",labelloc=t,fontsize=20,fontcolor="#0B6956"];
node [shape=box,style="rounded,filled",color="#14946C",penwidth=2,fillcolor="#E8F8F1",fontname="Arial",fontsize=15,margin="0.20,0.13"];
