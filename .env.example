# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
PORT=3000
# mssql = SQL Server (producción/demostración); memory = solo pruebas automatizadas y vistas previas sin base
DB_DRIVER=mssql
# DB_AUTH=windows usa la sesión de Windows (sin usuario ni contraseña; requiere msnodesqlv8 y ODBC Driver 18). DB_AUTH=sql usa DB_USER/DB_PASSWORD.
DB_AUTH=sql
DB_SERVER=localhost
# Puerto TCP (déjelo vacío con DB_AUTH=windows si TCP/IP está desactivado en el servidor)
DB_PORT=1433
DB_NAME=FarmaControlBD
DB_USER=farmacontrol_app
DB_PASSWORD=<contraseña-de-la-cuenta-de-aplicacion>
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
# Secreto de firma de tokens: cadena aleatoria de 32+ caracteres (ej.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=<secreto-aleatorio-largo>
TOKEN_TTL_MINUTES=480
# Sirve la carpeta ../frontend desde el mismo proceso (true) o solo la API (false)
SERVE_FRONTEND=true
# Origen permitido si el frontend se sirve aparte (ej.: http://localhost:5173)
CORS_ORIGIN=
